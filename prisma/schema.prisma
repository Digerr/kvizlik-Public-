generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  telegramId      String   @unique
  username        String?
  firstName       String
  lastName        String?
  avatarId        String   @default("default")
  totalScore      Int      @default(0)
  totalXP         Int      @default(0)
  gamesPlayed     Int      @default(0)
  totalCorrect    Int      @default(0)
  totalQuestions  Int      @default(0)
  bestStreak      Int      @default(0)
  coins           Int      @default(0)
  currentLeague   String   @default("bronze")
  level           Int      @default(1)
  dailyStreak     Int      @default(0)
  lastDailyAt     String?
  seenQuestions   String   @default("[]")
  powerUps        String   @default("{\"freeze\":0,\"fiftyFifty\":0,\"hint\":0}")
  unlockedAvatars String   @default("[\"default\"]")
  unlockedAchievements String @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions GameSession[]
}

model GameSession {
  id            String   @id @default(cuid())
  userId        String
  category      String
  difficulty    Int      @default(1)
  score         Int
  xpEarned      Int
  correctCount  Int
  questionCount Int
  bestStreak    Int
  avgTimeMs     Int
  powerUpsUsed  Int      @default(0)
  completedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model LeaderboardEntry {
  id        String   @id @default(cuid())
  userId    String   @unique
  score     Int
  updatedAt DateTime @updatedAt
}

model DailyChallenge {
  id          String   @id @default(cuid())
  date        String   @unique
  category    String
  difficulty  Int
  questions   String
  completedBy String   @default("[]")
  createdAt   DateTime @default(now())
}
